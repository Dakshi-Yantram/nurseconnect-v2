{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "// note": "VoIP push and CallKit do not work in the iOS Simulator — PushKit is device-only. Build for a real device.",
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "http://localhost:8001"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://staging-api.nurseconnect.example.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.nurseconnect.example.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
