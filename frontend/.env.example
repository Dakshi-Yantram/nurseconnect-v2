# ---------------------------------------------------------------------------
# NurseConnect mobile app configuration
#
# Copy to `.env` and point at your backend. This variable is REQUIRED: without
# it the HTTP client falls back to the relative path "/api", which resolves to
# nothing on a real device or simulator, so every request fails silently.
#
# Must be the origin only — no trailing slash and no /api suffix. The client
# appends /api itself, and derives the WebSocket URL from the same value.
# ---------------------------------------------------------------------------

# Local development. The backend listens on 8001 (see backend/README.md).
#   - iOS simulator:      http://localhost:8001
#   - Android emulator:   http://10.0.2.2:8001   (localhost is the emulator itself)
#   - Physical device:    http://<your-machine-LAN-IP>:8001
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# Staging / production — use https so the WebSocket upgrades to wss.
# EXPO_PUBLIC_BACKEND_URL=https://api.nurseconnect.example.com
